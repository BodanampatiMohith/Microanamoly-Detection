# Frontend Environment Variables
# Copy this file to .env.local and update values

# API Base URL for the Flask backend
# For local development (backend running on localhost:5000):
VITE_API_BASE_URL=http://localhost:5000

# For production with Hugging Face backend:
# VITE_API_BASE_URL=https://your-space-name.hf.space/api

# For production with custom backend:
# VITE_API_BASE_URL=https://your-backend-domain/api

# Build output directory (for production builds)
VITE_BUILD_OUT_DIR=dist
