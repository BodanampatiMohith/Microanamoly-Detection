.env.example
# Backend Environment Variables
# Copy this file to .env and update values

# Server configuration
PORT=5000
DEBUG=False

# CORS configuration
# For local development: "*" (allow all origins)
# For production with Vercel frontend: "https://your-vercel-project.vercel.app"
CORS_ORIGINS=*

# EVM Configuration (Euler Video Magnification)
EVM_LEVELS=4
EVM_AMPLIFICATION=20.0
EVM_FREQ_LOW=3.0
EVM_FREQ_HIGH=30.0
EVM_SAMPLING_RATE=30
EVM_BUFFER_SIZE=60
EVM_PYRAMID_TYPE=laplacian
EVM_FILTER_TYPE=butterworth
EVM_CHROMA_ATTENUATION=0.1

# API Configuration
API_MAX_FRAME_SIZE=10
API_SUPPORTED_FORMATS=jpg,jpeg,png
API_COMPRESSION_QUALITY=85
API_RATE_LIMIT=60
API_CORS_ENABLED=true
API_DEBUG=false

# Monitoring Configuration
MONITORING_RAW_HISTORY_SIZE=50000
MONITORING_AGGREGATE_HISTORY_MINUTES=10080

# EVM Configuration (can override config.py)
EVM_AMPLIFICATION=20
EVM_LEVELS=4
EVM_LOW_FREQ=3
EVM_HIGH_FREQ=30

# Anomaly Detection
ANOMALY_RMS_THRESHOLD=2.0
ANOMALY_FREQ_THRESHOLD=5.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Model Path
ML_MODEL_PATH=../data/models/anomaly_model.pkl
