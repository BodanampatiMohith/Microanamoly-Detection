.env.example

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# CORS
CORS_ORIGINS=localhost:3000,localhost:8000

# EVM Configuration (can override config.py)
EVM_AMPLIFICATION=20
EVM_LEVELS=4
EVM_LOW_FREQ=3
EVM_HIGH_FREQ=30

# Anomaly Detection
ANOMALY_RMS_THRESHOLD=2.0
ANOMALY_FREQ_THRESHOLD=5.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Model Path
ML_MODEL_PATH=../data/models/anomaly_model.pkl
